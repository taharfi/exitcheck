# Production never falls back to fixtures.
EXITCHECK_MODE=production
JUPITER_API_KEY=
# Server-only Panta market catalog/detail access. Keep it out of browser code.
PANTA_API_KEY=
# Optional server-only research key. Without it the terminal shows research unavailable.
GEMINI_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
APP_ORIGIN=http://127.0.0.1:3000
ACTION_DB_PATH=./data/actions.sqlite
# Explicit operator gate. Leave false until live validation and authorization.
ENABLE_LIVE_EXECUTION=false
# Required before signing: reviewed prediction program IDs, comma separated.
ALLOWED_PROGRAM_IDS=
# npm start enables all three collectors by default. For npm run dev, opt in explicitly.
# SHADOW_COLLECTOR_ENABLED=true
# MARKET_RECORDER_ENABLED=true
# AGENT_COLLECTOR_ENABLED=true
# Agent collector watches private trader plans; it cannot sign or submit orders.
SHADOW_DB_PATH=./data/shadow.sqlite

# Hosted Vercel deployment uses Turso and durable monitoring workflows.
# Configure these server-only values in Vercel; local SQLite remains the default.
# EXITCHECK_DATABASE=turso
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# MONITORING_WORKFLOW_ENABLED=true
# CRON_SECRET=

# Optional server-only Gemini key rotation (one key per complete research report).
# Paste keys after =. Numbered keys take priority over GEMINI_API_KEY.
# Same-project keys share quota; rotation does not increase provider limits.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Server-only research model.
GEMINI_MODEL=gemini-2.5-flash

# Server-only DeepSeek analysis (market rules; no hosted web search).
RESEARCH_PROVIDER=gemini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
